{
	"bsonType": "object",
	"description": "评论表：存储新闻评论，关联用户和新闻",
	"required": ["news_id", "user_id", "content", "comment_time"],
	"permission": {
		"read": true,
		"create": true, // 登录用户可发布评论
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "评论ID，系统自动生成"
		},
		"news_id": {
			"bsonType": "string",
			"title": "关联新闻ID",
			"foreignKey": {
				"collection": "News",
				"field": "_id"
			}
		},
		"user_id": {
			"bsonType": "string",
			"title": "评论用户ID",
			"foreignKey": {
				"collection": "UserInfo",
				"field": "_id"
			}
		},
		"content": {
			"bsonType": "string",
			"title": "评论内容",
			"trim": "both",
			"maxLength": 500
		},
		"comment_time": {
			"bsonType": "timestamp",
			"title": "评论时间"
		},
		"like_count": {
			"bsonType": "int",
			"title": "点赞数",
			"default": 0
		}
	}
}