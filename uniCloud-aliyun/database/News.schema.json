{
	"bsonType": "object",
	"description": "新闻表：存储新闻核心数据",
	"required": ["title", "cover", "summary", "author", "category", "publish_time"],
	"permission": {
		"read": true, // 前端可直接读取新闻
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "新闻ID，系统自动生成"
		},
		"title": {
			"bsonType": "string",
			"title": "新闻标题",
			"trim": "both",
			"maxLength": 100
		},
		"cover": {
			"bsonType": "string",
			"title": "新闻封面图",
			"description": "图片URL路径"
		},
		"summary": {
			"bsonType": "string",
			"title": "新闻摘要",
			"maxLength": 500
		},
		"author": {
			"bsonType": "string",
			"title": "新闻来源"
		},
		"category": {
			"bsonType": "string",
			"title": "新闻分类",
			"enum": ["推荐", "时政", "财经", "军事", "娱乐", "科技"] // 固定分类
		},
		"publish_time": {
			"bsonType": "timestamp",
			"title": "发布时间"
		},
		"comments_count": {
			"bsonType": "int",
			"title": "评论数",
			"default": 0 // 默认评论数为0
		},
		"is_top": {
			"bsonType": "bool",
			"title": "是否置顶",
			"default": false
		}
	}
}